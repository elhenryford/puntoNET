@page "/carreras"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using pruevaDB1.Components.Model
@using pruevaDB1.Data
@implements IAsyncDisposable
@inject IDbContextFactory<pruevaDB1.Data.pruevaDB1Context> DbFactory

<PageTitle>Index</PageTitle>

<style>
    .custom-class {
        max-width: 120px; /* Restrict the maximum width to 100px */
        word-wrap: break-word; /* Forces long words to break onto the next line */
        overflow-wrap: break-word;
        white-space: normal;
    }
</style>

<h1>Index</h1>


<QuickGrid Class="table" Items="context.Carreras">
    <PropertyColumn Property="carrera => carrera.Nombre" Class="custom-class" />
    <PropertyColumn Property="carrera => carrera.HoraInicio" Title="Fecha" Class="custom-class" />
    <PropertyColumn Property="carrera => carrera.Ubicacion" Class="custom-class" />
    <PropertyColumn Property="carrera => carrera.Cupos" Class="custom-class" />

    <TemplateColumn Context="carrera">
        <a href="@($"carreras/details?idcarrera={carrera.IdCarrera}")">Details</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private pruevaDB1Context context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
