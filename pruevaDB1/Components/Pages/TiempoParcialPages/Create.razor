@page "/tiempoparcials/create"
@using Microsoft.EntityFrameworkCore
@using pruevaDB1.Components.Model
@inject IDbContextFactory<pruevaDB1.Data.pruevaDB1Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>TiempoParcial</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm Model="TiempoParcial" OnValidSubmit="AddTiempoParcial" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="mb-3">
                <label for="inscripcionid" class="form-label">InscripcionId:</label>
                <InputNumber id="inscripcionid" @bind-Value="TiempoParcial.InscripcionId" class="form-control" />
                <ValidationMessage For="@(() => TiempoParcial.InscripcionId)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="puesto" class="form-label">Puesto:</label> 
                <InputNumber id="puesto" @bind-Value="TiempoParcial.Puesto" class="form-control" /> 
                <ValidationMessage For="@(() => TiempoParcial.Puesto)" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="numerodorsal" class="form-label">NumeroDorsal:</label> 
                <InputNumber id="numerodorsal" @bind-Value="TiempoParcial.NumeroDorsal" class="form-control" /> 
                <ValidationMessage For="@(() => TiempoParcial.NumeroDorsal)" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="chipid" class="form-label">ChipID:</label> 
                <InputNumber id="chipid" @bind-Value="TiempoParcial.ChipID" class="form-control" /> 
                <ValidationMessage For="@(() => TiempoParcial.ChipID)" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="horapaso" class="form-label">HoraPaso:</label> 
                <InputDate id="horapaso" @bind-Value="TiempoParcial.HoraPaso" class="form-control" />
                <ValidationMessage For="@(() => TiempoParcial.HoraPaso)" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/tiempoparcials">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private TiempoParcial TiempoParcial { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddTiempoParcial()
    {
        using var context = DbFactory.CreateDbContext();
        context.TiemposParciales.Add(TiempoParcial);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/tiempoparcials");
    }
}
