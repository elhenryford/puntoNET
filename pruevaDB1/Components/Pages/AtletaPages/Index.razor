@page "/atleta"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using pruevaDB1.Components.Model
@using pruevaDB1.Data
@implements IAsyncDisposable
@inject IDbContextFactory<pruevaDB1.Data.pruevaDB1Context> DbFactory

<PageTitle>Index</PageTitle>

<style>
    .custom-class {
        max-width: 120px; /* Restrict the maximum width to 100px */
        word-wrap: break-word; /* Forces long words to break onto the next line */
        overflow-wrap: break-word;
        white-space: normal;
    }
</style>

<h1>Index</h1>

<p>
    <a href="atleta/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Atletas">
    <PropertyColumn Property="atleta => atleta.Nombre" Class="custom-class" />
    <PropertyColumn Property="atleta => atleta.Mail" Class="custom-class" />
    <PropertyColumn Property="atleta => atleta.Edad" Class="custom-class" />
    <PropertyColumn Property="atleta => atleta.NumeroDorsal" Title="Numero Dorsal" Class="custom-class" />
    <PropertyColumn Property="atleta => atleta.Discapacidades" Class="custom-class" />

    <TemplateColumn Context="atleta">
        <a href="@($"atleta/details?idatleta={atleta.IdAtleta}")">Details</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private pruevaDB1Context context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
