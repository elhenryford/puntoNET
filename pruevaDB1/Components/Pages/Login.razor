@page "/login"
@using Microsoft.AspNetCore.Components
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@using pruevaDB1.Components.Model
@using pruevaDB1.Data
@inject IDbContextFactory<pruevaDB1.Data.pruevaDB1Context> DbFactory
@inject HttpClient Http

<PageTitle>Login</PageTitle>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow p-4" style="width: 100%; max-width: 420px; border-radius: 20px;">
        <h2 class="text-center mb-4">Iniciar Sesión</h2>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger text-center">@ErrorMessage</div>
        }

        <EditForm Model="@loginData" OnValidSubmit="HandleLogin" FormName="loginForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="username" class="form-label fw-bold">Usuario</label>
                <InputText id="username" class="form-control form-control-lg"
                           style="border-radius: 12px;"
                           @bind-Value="loginData.Username" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label fw-bold">Contraseña</label>
                <InputText id="password" type="password" class="form-control form-control-lg"
                           style="border-radius: 12px;"
                           @bind-Value="loginData.Password" />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2"
                    style="border-radius: 12px; font-size: 1.1rem;">
                Entrar
            </button>
        </EditForm>
    </div>
</div>

@code {

    private LoginData loginData = new();
    private pruevaDB1Context context = default!;
    private string? ErrorMessage;

    private async Task HandleLogin()
    {
        if (loginData.Username == "admin" && loginData.Password == "1234")
        {
            NavigationManager.NavigateTo("/carrerasAdmin");
            return;
        }

        context = DbFactory.CreateDbContext();

        var atleta = await context.Atletas
            .FirstOrDefaultAsync(a => a.Mail == loginData.Username && a.Password == loginData.Password);

        if (atleta != null)
        {
            NavigationManager.NavigateTo($"/atleta/inscribirse/{atleta.IdAtleta}");
        }
        else
        {
            ErrorMessage = "Usuario o contraseña incorrectos.";
        }
    }

    public class LoginData
    {
        public string? Username { get; set; }
        public string? Password { get; set; }
    }
}

